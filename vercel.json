{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/main.py"
    },
    {
      "source": "/",
      "destination": "/frontend/build/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/build/web/$1"
    }
  ]
}
